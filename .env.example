# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SITE_URL=http://localhost:3000
# Production builds should use:
# VITE_SITE_URL=https://www.adsroadindia.com

# Razorpay — server (never expose KEY_SECRET to frontend)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_secret_here

# Razorpay — Vite frontend (Key ID only)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
VITE_RAZORPAY_AMOUNT_PAISE=10000
VITE_RAZORPAY_CURRENCY=INR
VITE_RAZORPAY_PLAN_LABEL=Billboard Ad Space (1 month)
